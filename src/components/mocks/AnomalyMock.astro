---
/**
 * AnomalyMock — a triggered surveillance insight.
 *
 * Shows the price-move trigger, the generated commentary, and the thresholds
 * that govern it. No sector-volume claim: the catalogue documents only the two
 * percent absolute move.
 */
import TerminalFrame from '@/components/ui/TerminalFrame.astro';
import { anomalyMock } from '@/content/landing';
---

<TerminalFrame
  label={anomalyMock.frameLabel}
  status={anomalyMock.status}
  statusVariant="pink"
  class="surveillance-signal"
>
  <div class="grid gap-4 sm:grid-cols-[0.72fr_1.28fr]">
    <!-- The trigger reads like a market alert, not another stack of cards. -->
    <aside class="rounded-panel bg-ink p-5 text-white">
      <div class="flex items-center justify-between gap-3">
        <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-emerald-300">
          Price signal
        </span>
        <span class="flex items-center gap-1.5 font-mono text-[9px] text-white/55">
          <span class="h-1.5 w-1.5 rounded-full bg-error"></span>
          LIVE
        </span>
      </div>

      <span class="mt-6 block font-mono text-xs text-white/60">
        {anomalyMock.symbol}
      </span>
      <strong class="mt-1 block font-mono text-4xl tracking-tight text-emerald-300">
        {anomalyMock.move}
      </strong>
      <span class="mt-2 block font-mono text-[10px] uppercase tracking-wider text-white/45">
        {anomalyMock.window}
      </span>

      <div class="mt-6 border-t border-white/15 pt-4">
        <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-white/45">
          Sentiment
        </span>
        <strong class="mt-1 block text-sm text-white">
          {anomalyMock.sentiment}
        </strong>
      </div>
    </aside>

    <div class="flex min-w-0 flex-col gap-4">
      <div class="border-l-2 border-warning bg-warning/5 px-4 py-3">
        <div class="flex items-center justify-between gap-3">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-warning">
            {anomalyMock.severity}
          </span>
          <span class="font-mono text-[9px] text-muted-soft">NO MATCHING NEWS</span>
        </div>
        <h4 class="mt-2 text-base font-semibold leading-snug text-ink">
          {anomalyMock.headline}
        </h4>
        <p class="mt-2 text-xs leading-relaxed text-muted">
          {anomalyMock.commentary}
        </p>
      </div>

      <div>
        <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-muted-soft">
          Trigger logic
        </span>
        <dl class="mt-2 grid grid-cols-3 divide-x divide-hairline overflow-hidden rounded-panel border border-hairline/70 bg-white">
          {
            anomalyMock.rows.map((row) => (
              <div class="min-w-0 p-3">
                <dt class="text-[9px] uppercase tracking-wide text-muted-soft">
                  {row.label}
                </dt>
                <dd class="mt-1 break-words font-mono text-[10px] font-semibold text-ink">
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <p class="text-[10px] leading-relaxed text-muted-soft">
        No cause found? The terminal says so instead of inventing one.
      </p>
    </div>
  </div>
</TerminalFrame>

<style>
  :global(.surveillance-signal) {
    background-image:
      linear-gradient(rgba(5, 150, 105, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(5, 150, 105, 0.035) 1px, transparent 1px);
    background-size: 20px 20px;
    box-shadow: 0 10px 28px rgba(18, 49, 38, 0.08);
  }
</style>
