---
/**
 * GhostLineMock — four projection models over one price history.
 *
 * Switching model changes the forward path, which is the whole argument of the
 * section: four different sets of mathematics are free to disagree.
 */
import TerminalFrame from '@/components/ui/TerminalFrame.astro';
import TabSwitcher from '@/components/ui/TabSwitcher.astro';
import { ghostLineMock } from '@/content/landing';

const HISTORY =
  'M0,92 L20,88 L40,95 L60,80 L80,84 L100,72 L120,76 L140,64 L160,68 L180,58 L200,54';

/** Forward paths, all anchored on the last close at (200, 54). */
const projectionPaths: Record<string, string> = {
  ols: 'M200,54 L310,34',
  vwlr: 'M200,54 L310,25',
  vwepr: 'M200,54 Q258,38 310,41',
  fcst: 'M200,54 L310,45',
};

const tabs = ghostLineMock.modes.map((mode) => ({
  id: mode.id,
  label: mode.label,
}));
---

<TerminalFrame
  label={ghostLineMock.frameLabel}
  status={ghostLineMock.status}
  statusVariant="violet"
  class="ghostline-comparator"
>
  <div class="grid gap-4 sm:grid-cols-[8.5rem_1fr]">
    <aside class="flex flex-col gap-3">
      <div>
        <span
          class="font-mono text-[9px] uppercase tracking-[0.2em] text-muted-soft"
        >
          Select model
        </span>
        <TabSwitcher
          group="ghostline"
          tabs={tabs}
          class="mt-2 !grid !w-full !grid-cols-2 !rounded-panel"
        />
      </div>

      {
        ghostLineMock.modes.map((mode, index) => (
          <div
            data-tab-panel="ghostline"
            data-tab={mode.id}
            class:list={[
              'rounded-panel bg-surface-strong p-4 text-ink',
              index !== 0 && 'hidden',
            ]}
          >
            <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-ink">
              Active model
            </span>
            <strong class="mt-2 block text-xl tracking-tight">{mode.label}</strong>
            <p class="mt-1 text-[10px] leading-relaxed text-muted">
              {mode.math}
            </p>
            <span class="mt-4 block border-t border-white/15 pt-3 font-mono text-[9px] text-muted">
              {mode.window} window
            </span>
          </div>
        ))
      }
    </aside>

    <div class="flex min-w-0 flex-col gap-3">
      <!-- Chart: shared history, one forward path per model -->
      <div class="overflow-hidden rounded-panel border border-hairline/70 bg-white p-3">
        <div class="mb-2 flex items-center justify-between gap-3">
          <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted-soft">
            Measured
          </span>
          <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-projection">
            Projected →
          </span>
        </div>
        <svg
          viewBox="0 0 320 120"
          class="w-full h-auto"
          role="img"
          aria-label="Price history with a dashed forward projection"
        >
          {
            [24, 48, 72, 96].map((y) => (
              <line
                x1="0"
                y1={y}
                x2="320"
                y2={y}
                stroke="currentColor"
                stroke-width="0.5"
                class="text-hairline"
              />
            ))
          }
          <line
            x1="200"
            y1="4"
            x2="200"
            y2="116"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="2 3"
            class="text-muted-soft"></line>
          <path
            d={HISTORY}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-ink"></path>
          {
            ghostLineMock.modes.map((mode, index) => (
              <path
                data-tab-panel="ghostline"
                data-tab={mode.id}
                class:list={['text-projection', index !== 0 && 'hidden']}
                d={projectionPaths[mode.id]}
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-dasharray="5 4"
                stroke-linecap="round"
              />
            ))
          }
          <circle cx="200" cy="54" r="3" fill="currentColor" class="text-ink"
          ></circle>
        </svg>
      </div>

      {
        ghostLineMock.modes.map((mode, index) => (
          <dl
            data-tab-panel="ghostline"
            data-tab={mode.id}
            class:list={[
              'grid grid-cols-3 divide-x divide-hairline overflow-hidden rounded-panel border border-hairline/70 bg-white',
              index !== 0 && 'hidden',
            ]}
          >
            {mode.rows.map((row) => (
              <div class="min-w-0 p-3">
                <dt class="text-[9px] uppercase tracking-wide text-muted-soft">
                  {row.label}
                </dt>
                <dd class="mt-1 break-words font-mono text-[10px] font-semibold text-ink">
                  {row.value}
                </dd>
              </div>
            ))}
          </dl>
        ))
      }
    </div>
  </div>
</TerminalFrame>

<style>
  :global(.ghostline-comparator) {
    background-image:
      linear-gradient(rgba(124, 58, 237, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 58, 237, 0.035) 1px, transparent 1px);
    background-size: 20px 20px;
    box-shadow: 0 10px 28px rgba(46, 36, 64, 0.08);
  }
</style>
