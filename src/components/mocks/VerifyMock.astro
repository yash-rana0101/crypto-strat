---
/**
 * VerifyMock — a rejection, not a pass.
 *
 * The panel deliberately shows a setup that fails the stop-distance check and
 * returns the `stop-too-tight` reason tag, with the reward-to-risk check marked
 * unreached because the checks stop at the first failure.
 */
import TerminalFrame from '@/components/ui/TerminalFrame.astro';
import { verifyMock } from '@/content/landing';

const stateStyles = {
  pass: {
    text: 'text-ink',
    mark: '✓',
  },
  fail: {
    text: 'text-ink',
    mark: '✕',
  },
  skipped: {
    text: 'text-muted-soft',
    mark: '–',
  },
} as const;
---

<TerminalFrame
  label={verifyMock.frameLabel}
  status={verifyMock.status}
  statusVariant="orange"
  class="verify-receipt"
>
  <!-- A compact audit receipt: inputs, ordered gates, then one clear verdict. -->
  <div class="grid gap-4 sm:grid-cols-[0.72fr_1.28fr] sm:items-start">
    <aside class="flex flex-col gap-3 sm:sticky sm:top-4">
      <div class="rounded-panel bg-surface-strong p-4 text-ink shadow-card">
        <span
          class="font-mono text-[9px] uppercase tracking-[0.22em] text-ink"
        >
          {verifyMock.inputsLabel}
        </span>
        <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-4">
          {
            verifyMock.inputs.map((input, index) => (
              <div
                class:list={[
                  'min-w-0',
                  (index === 0 || index === 5) && 'col-span-2',
                  index === 0 && 'border-b border-white/15 pb-3',
                ]}
              >
                <dt class="text-[9px] uppercase tracking-wider text-muted">
                  {input.label}
                </dt>
                <dd class="mt-0.5 font-mono text-sm font-bold text-ink">
                  {input.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="rounded-panel border border-error/40 bg-error/5 p-4">
        <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-ink">
          Final decision
        </span>
        <div class="mt-2 flex flex-col items-start gap-1.5">
          <strong class="text-xl tracking-tight text-ink">
            {verifyMock.verdict.label}
          </strong>
          <span
            class="rounded border border-error/30 px-1.5 py-0.5 font-mono text-[9px] text-ink"
          >
            {verifyMock.verdict.tag}
          </span>
        </div>
        <p class="mt-2 text-[11px] leading-relaxed text-muted">
          {verifyMock.verdict.note}
        </p>
      </div>
    </aside>

    <div class="flex min-w-0 flex-col gap-4">
      <div class="rounded-panel border border-hairline/70 bg-white p-4">
        <div class="flex items-center justify-between gap-3">
          <span
            class="font-mono text-[9px] uppercase tracking-[0.22em] text-muted-soft"
          >
            {verifyMock.checksLabel}
          </span>
          <span class="font-mono text-[9px] text-muted-soft">FIRST FAIL STOPS</span>
        </div>
        <ol class="mt-3 list-none" role="list">
          {
            verifyMock.checks.map((check, index) => {
              const style = stateStyles[check.state];
              return (
                <li
                  class:list={[
                    'grid grid-cols-[1.75rem_1fr] gap-3 border-t border-hairline/50 py-3 first:border-t-0 first:pt-0 last:pb-0',
                    check.state === 'fail' &&
                      '-mx-2 rounded-lg border border-error/25 bg-error/5 px-2',
                  ]}
                >
                  <span
                    class:list={[
                      'flex h-7 w-7 items-center justify-center rounded-full border font-mono text-[10px] font-bold',
                      check.state === 'pass' &&
                        'border-success/30 bg-success/10 text-ink',
                      check.state === 'fail' &&
                        'border-error/40 bg-error text-ink',
                      check.state === 'skipped' &&
                        'border-hairline bg-surface-soft text-muted-soft',
                    ]}
                    aria-label={`Check ${index + 1}: ${check.state}`}
                  >
                    {check.state === 'skipped' ? index + 1 : style.mark}
                  </span>
                  <div class="flex min-w-0 items-start justify-between gap-3">
                    <div class="min-w-0">
                      <span class="text-xs font-semibold leading-5 text-ink">
                        {check.label}
                      </span>
                      <span
                        class:list={[
                          'mt-0.5 block font-mono text-[10px]',
                          style.text,
                        ]}
                      >
                        {check.detail}
                      </span>
                    </div>
                    <span class:list={['font-mono text-[9px] uppercase', style.text]}>
                      {check.state}
                    </span>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>

      <div class="border-l-2 border-ink bg-surface-soft/60 px-4 py-3">
        <div class="flex items-center justify-between gap-3">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-ink">
            Devil's advocate
          </span>
          <span class="text-[9px] font-semibold uppercase tracking-wider text-muted-soft">
            Advisory only
          </span>
        </div>
        <p class="mt-2 text-xs font-medium leading-relaxed text-ink">
          {verifyMock.critique[0]}
        </p>
        <p class="mt-2 text-[10px] leading-relaxed text-muted-soft">
          + {verifyMock.critique.length - 1} more objections reviewed
        </p>
      </div>
    </div>
  </div>
</TerminalFrame>

<style>
  :global(.verify-receipt) {
    background-image:
      linear-gradient(rgba(124, 58, 237, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 58, 237, 0.035) 1px, transparent 1px);
    background-size: 20px 20px;
    box-shadow: 0 10px 28px rgba(46, 36, 64, 0.08);
  }
</style>
