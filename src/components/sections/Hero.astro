---
/**
 * Hero — Center-aligned copy framed by finance and crypto doodles.
 *
 * Copy comes from `src/content/landing/hero.ts`. Layering architecture:
 * z-0  : decorative doodles, technical field, and glow
 * z-10 : product terminal illustration
 * z-20 : header content
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import HeroIllustration from './HeroIllustration.astro';
import HeroDoodles from './HeroDoodles.astro';
import { hero } from '@/content/landing';
---

<section
  class="hero-shell relative pt-24 sm:pt-28 lg:pt-32 pb-0 overflow-hidden bg-canvas transition-colors duration-300 flex flex-col"
  id="hero"
  aria-labelledby="hero-heading"
>
  <!-- Light technical field and the supplied transparent doodle sheet. -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="hero-starfield absolute inset-0"></div>
    <div class="hero-glow absolute inset-x-[15%] top-[8%] h-[520px]"></div>
    <HeroDoodles />
  </div>

  <Container size="wide" class="hero-content relative z-20">
    <div
      class="flex flex-col items-center text-center gap-3 max-w-4xl mx-auto"
      data-reveal-group
    >
      <!-- Top pill badge -->
      <div data-reveal-item class="reveal reveal-scale-up">
        <div
          class="inline-flex items-center gap-2 px-4 py-1 rounded-full border border-violet-500/30 bg-violet-500/10 backdrop-blur-md text-xs font-medium text-ink shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-pink-600"
          ></span>
          <span
            >{hero.attribution.prefix}{' '}<a
              href={hero.attribution.href}
              class="text-ink font-semibold hover:underline"
              target="_blank"
              rel="noopener noreferrer">{hero.attribution.label}</a
            ></span
          >
        </div>
      </div>

      <h1
        id="hero-heading"
        class="text-[2.65rem] sm:text-6xl lg:text-[4.5rem] font-body font-bold tracking-[-0.045em] text-ink leading-[1.04] text-center max-w-[900px] reveal reveal-scale-up"
        data-reveal-item
      >
        {hero.heading}
      </h1>

      <p
        class="type-body-md text-body text-sm sm:text-lg leading-relaxed max-w-2xl text-center font-normal reveal reveal-scale-up"
        data-reveal-item
      >
        {hero.body}
      </p>

      <section
        class="flex flex-col items-center gap-2 mt-3 reveal reveal-scale-up"
        data-reveal-item
        aria-labelledby="hero-product-hunt-heading"
      >
        <h2 id="hero-product-hunt-heading" class="text-sm font-medium text-body">
          {hero.productHunt.label}
        </h2>
        <a
          href={hero.productHunt.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-lg hover:opacity-90 transition-opacity"
        >
          <img
            src={hero.productHunt.badgeSrc}
            alt={hero.productHunt.badgeAlt}
            width="250"
            height="54"
            class="block w-[250px] max-w-full h-auto"
          />
        </a>
      </section>

      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-3 reveal reveal-scale-up"
        data-reveal-item
      >
        <Button
          variant="primary"
          size="lg"
          href={hero.primaryCta.href}
          class="!rounded-full min-w-48 px-9 py-3.5 font-semibold text-sm hover:scale-[1.03] transition-all duration-300 border-none"
        >
          {hero.primaryCta.label}
        </Button>
      </div>

      <p
        class="text-xs text-muted-soft max-w-md leading-relaxed mt-2"
        data-reveal-item
      >
        {hero.note}
      </p>
    </div>
  </Container>

  <!-- Product terminal rises from the base of the illustrated field. -->
  <div
    class="w-full relative z-10 mt-8 sm:mt-10 lg:mt-12 reveal reveal-scale-up"
    data-reveal-group
  >
    <HeroIllustration />
  </div>

</section>

<script>
  import { animate, scroll } from 'motion';

  let cleanupHeroMotion = () => {};
  let introPlayed = false;

  function initHeroMotion() {
    cleanupHeroMotion();

    const heroSection = document.getElementById('hero');
    if (!heroSection) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 767px)');
    const hoverPointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const cleanups: Array<() => void> = [];

    [reducedMotion, mobile, hoverPointer].forEach((query) => {
      query.addEventListener('change', initHeroMotion);
      cleanups.push(() => query.removeEventListener('change', initHeroMotion));
    });

    if (!reducedMotion.matches) {
      heroSection.querySelectorAll<HTMLElement>('[data-hero-parallax]').forEach((element) => {
        if (getComputedStyle(element).display === 'none') return;

        const distance = Number(element.dataset.heroParallax) * (mobile.matches ? 0.4 : 1);
        const animation = animate(element, { y: [0, distance] }, { ease: 'linear' });
        const stopScroll = scroll(animation, {
          target: heroSection,
          offset: ['start start', 'end start'],
        });

        cleanups.push(() => {
          stopScroll();
          animation.cancel();
        });
      });

      const doodles = Array.from(heroSection.querySelectorAll<HTMLElement>('.doodle'))
        .filter((element) => getComputedStyle(element).display !== 'none');

      doodles.forEach((element, index) => {
        const artwork = element.querySelector<HTMLElement>('.doodle-artwork');
        if (!artwork) return;

        // Let the text reveal finish before the artwork zooms into place.
        const delay = introPlayed ? 0 : 1.4 + index * 0.035;
        const duration = introPlayed ? 0 : 0.9;
        const entrance = animate(artwork, {
          opacity: [introPlayed ? 1 : 0, 1],
          scale: [introPlayed ? 1 : 0.72, 1],
        }, { delay, duration, ease: [0.16, 1, 0.3, 1] });

        // Alternate directions and speeds for a gentle, continuous sway.
        const angle = Number(element.dataset.doodleDirection) * 5;
        const rotation = animate(artwork, { rotate: [angle, -angle] }, {
          delay: delay + duration,
          duration: 8 + index % 4,
          ease: 'easeInOut',
          repeat: Infinity,
          repeatType: 'reverse',
        });

        cleanups.push(() => {
          entrance.cancel();
          rotation.cancel();
          artwork.style.removeProperty('transform');
          artwork.style.removeProperty('opacity');
        });
      });

      if (hoverPointer.matches) {
        const field = heroSection.querySelector<HTMLElement>('.hero-doodles');
        const layers = doodles.map((element) => ({
          element: element.querySelector<HTMLElement>('.doodle-hover'),
          depth: Math.abs(Number(element.dataset.heroParallax)) * 0.18,
        }));
        const hoverAnimations = new Map<HTMLElement, { stop: () => void; cancel: () => void }>();

        function moveDoodles(x: number, y: number) {
          layers.forEach(({ element, depth }) => {
            if (!element) return;
            hoverAnimations.get(element)?.stop();
            hoverAnimations.set(element, animate(element, {
              x: x * depth,
              y: y * depth,
            }, { duration: 0.6, ease: 'easeOut' }));
          });
        }

        function onPointerMove(event: PointerEvent) {
          if (event.pointerType !== 'mouse' || !field) return;
          const bounds = field.getBoundingClientRect();
          if (event.clientY < bounds.top || event.clientY > bounds.bottom) {
            moveDoodles(0, 0);
            return;
          }
          const x = (event.clientX - bounds.left) / bounds.width * 2 - 1;
          const y = (event.clientY - bounds.top) / bounds.height * 2 - 1;
          moveDoodles(x, y);
        }

        const resetDoodles = () => moveDoodles(0, 0);
        heroSection.addEventListener('pointermove', onPointerMove, { passive: true });
        heroSection.addEventListener('pointerleave', resetDoodles);
        window.addEventListener('blur', resetDoodles);
        cleanups.push(() => {
          heroSection.removeEventListener('pointermove', onPointerMove);
          heroSection.removeEventListener('pointerleave', resetDoodles);
          window.removeEventListener('blur', resetDoodles);
          hoverAnimations.forEach((animation, element) => {
            animation.cancel();
            element.style.removeProperty('transform');
          });
        });
      }
    }

    introPlayed = true;
    cleanupHeroMotion = () => {
      cleanups.forEach((cleanup) => cleanup());
      cleanupHeroMotion = () => {};
    };
  }

  initHeroMotion();
  document.addEventListener('astro:after-swap', () => {
    introPlayed = false;
    initHeroMotion();
  });
  document.addEventListener('astro:before-swap', () => cleanupHeroMotion());
</script>

<style>
  .hero-starfield {
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(124, 58, 237, 0.16) 0.8px,
      transparent 0
    ) !important;
    background-size: 26px 26px;
    opacity: 0.42;
    mask-image: linear-gradient(to bottom, black 0%, black 76%, transparent 100%);
  }

  .hero-glow {
    background: radial-gradient(
      ellipse at center,
      rgba(124, 58, 237, 0.09) 0%,
      rgba(196, 181, 253, 0.04) 46%,
      transparent 74%
    );
    filter: blur(60px);
  }

  @media (max-width: 767px) {
    .hero-content {
      text-shadow: 0 1px 18px rgba(255, 255, 255, 0.92);
    }
  }
</style>
