---
/**
 * HeroIllustration — Strat AI Terminal Product Screenshot (/hero/hero-dark.png).
 * Mounted inside a crisp floating terminal frame below the illustrated hero copy.
 * The product screenshot displays its original colors without a tint or filter.
 */
---

<div
  class="relative w-full flex items-start justify-center px-4 sm:px-8 lg:px-12"
>
  <!-- Lavender glow anchors the product terminal to the light hero. -->
  <div
    id="hero-planet-wrapper"
    class="absolute -top-20 inset-x-0 w-full flex justify-center pointer-events-none z-0 overflow-visible"
  >
    <div
      id="hero-planet-target"
      data-hero-parallax="30"
      class="relative w-[130vw] max-w-none flex flex-col items-center justify-start origin-top shrink-0"
    >
      <!-- Glowing Atmosphere Soft Layer Behind Planet Arc -->
      <div
        class="hero-atmosphere absolute top-0 w-full h-[250px] rounded-[50%] pointer-events-none animate-atmosphere-opacity"
      >
      </div>

      <!-- Full-Bleed 3D Curved Planet Horizon SVG -->
      <svg
        viewBox="0 0 1440 220"
        preserveAspectRatio="none"
        class="w-full h-[210px] sm:h-[240px] lg:h-[270px]"
      >
        <defs>
          <radialGradient
            id="stratBrandGradientLight"
            cx="50%"
            cy="0%"
            r="90%"
            fx="50%"
            fy="0%"
          >
            <stop offset="0%" stop-color="#c4b5fd" stop-opacity="0.34"></stop>
            <stop offset="30%" stop-color="#ddd6fe" stop-opacity="0.24"></stop>
            <stop offset="62%" stop-color="#ede9fe" stop-opacity="0.13"></stop>
            <stop offset="84%" stop-color="#f5f3ff" stop-opacity="0.05"></stop>
            <stop offset="100%" stop-color="#faf5ff" stop-opacity="0"></stop>
          </radialGradient>

          <linearGradient id="stratRimGlow" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#c4b5fd" stop-opacity="0.22"></stop>
            <stop offset="50%" stop-color="#a78bfa" stop-opacity="0.46"></stop>
            <stop offset="100%" stop-color="#c4b5fd" stop-opacity="0.22"></stop>
          </linearGradient>

          <filter id="softRimBlur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="14"></feGaussianBlur>
          </filter>
        </defs>

        <path
          d="M -200 220 Q 720 40 1640 220 L 1640 220 L -200 220 Z"
          fill="url(#stratBrandGradientLight)"
        ></path>

        <path
          d="M -200 220 Q 720 40 1640 220"
          fill="none"
          stroke="url(#stratRimGlow)"
          stroke-width="6"
          filter="url(#softRimBlur)"
          class="animate-rim-glow"></path>
      </svg>
    </div>
  </div>

  <!-- Keep scroll movement separate from the frame's entrance reveal. -->
  <div class="relative z-20 w-full max-w-[1240px]" data-hero-parallax="-18">
    <!-- FLOATING GLASS TERMINAL HERO PRODUCT IMAGE FRAME -->
    <div
      id="hero-card-left"
      data-reveal-item
      class="hero-terminal-frame reveal-item relative w-full rounded-2xl sm:rounded-[1.65rem] overflow-hidden border border-violet-200/90 bg-white/95 backdrop-blur-2xl shadow-[0_28px_90px_rgba(124,58,237,0.18),0_4px_18px_rgba(26,15,42,0.10)]"
    >
      <!-- Product Image Container -->
      <div class="w-full relative bg-canvas">
        <img
          id="hero-illustration-image"
          src="/hero/hero-dark.png"
          alt="Strat AI Terminal Dashboard Screenshot"
          width={1920}
          height={988}
          class="w-full h-auto object-cover block"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes atmosphereOpacity {
    0%,
    100% {
      opacity: 0.42;
    }
    50% {
      opacity: 0.58;
    }
  }

  @keyframes rimGlowShift {
    0% {
      opacity: 0.4;
      stroke: url(#stratRimGlow);
    }
    50% {
      opacity: 0.58;
      stroke: url(#stratRimGlow);
    }
    100% {
      opacity: 0.4;
      stroke: url(#stratRimGlow);
    }
  }

  .animate-atmosphere-opacity {
    animation: atmosphereOpacity 6s ease-in-out infinite;
  }

  .animate-rim-glow {
    animation: rimGlowShift 4s ease-in-out infinite;
  }

  .hero-atmosphere {
    background: radial-gradient(
      ellipse at top,
      rgba(124, 58, 237, 0.2) 0%,
      rgba(167, 139, 250, 0.12) 38%,
      rgba(221, 214, 254, 0.06) 72%,
      transparent 96%
    ) !important;
    filter: blur(90px) !important;
  }
</style>
