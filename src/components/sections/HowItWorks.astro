---
/**
 * HowItWorks — the three-layer engine underneath the headline features.
 *
 * Answers the question the deep dives raise: where do the numbers come from,
 * and why can the model not invent one. Copy lives in
 * `src/content/landing/engine.ts`.
 *
 * The terminal dashboard and tab bar that used to live here now live in
 * `src/components/mocks/` and `src/components/ui/TabSwitcher.astro`.
 */
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { engine } from '@/content/landing';

const { intro, layers, punchline } = engine;
---

<section
  class="section-y bg-surface-soft"
  id={intro.id}
  aria-labelledby="engine-heading"
>
  <Container>
    <div
      class="mx-auto mb-10 grid max-w-[1080px] gap-5 md:grid-cols-[0.82fr_1.18fr] md:items-end md:gap-14"
      data-reveal-group
    >
      <div>
        <div data-reveal-item>
          <Badge variant="lavender" class="mb-4">{intro.badge}</Badge>
        </div>
        <h2
          id="engine-heading"
          class="type-display-lg leading-[1.05] tracking-tight text-ink"
          data-reveal-item
        >
          {intro.heading}
        </h2>
      </div>
      {
        intro.body && (
          <p class="type-body-md max-w-[560px] text-muted md:pb-1" data-reveal-item>
            {intro.body}
          </p>
        )
      }
    </div>
  </Container>

  <Container>
    <div
      class="mx-auto max-w-[1080px] overflow-hidden rounded-[1.5rem] border border-hairline bg-white"
      data-reveal-group
    >
      <div class="flex items-center justify-between gap-4 border-b border-hairline px-5 py-3 sm:px-7">
        <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-muted-soft">
          Number provenance
        </span>
        <span class="flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.16em] text-ink">
          <span class="h-1.5 w-1.5 rounded-full bg-badge-lavender"></span>
          Contract enforced
        </span>
      </div>

      <!-- One continuous route replaces three prose-heavy cards. -->
      <div
        class="grid md:grid-cols-[1fr_2.5rem_1fr_2.5rem_1fr]"
        aria-label="Market data to model path"
      >
        {
          layers.map((layer, index) => (
            <>
              <article
                class:list={[
                  'reveal-item relative min-h-[270px] overflow-hidden p-6 sm:p-8',
                  index === 1 ? 'bg-success/10' : 'bg-white',
                ]}
              >
                <span class="pointer-events-none absolute -right-2 -top-8 font-mono text-[7rem] font-bold leading-none text-ink/[0.035]">
                  {layer.index}
                </span>
                <div class="relative flex h-full flex-col">
                  <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-ink">
                    {layer.index} / {layer.label}
                  </span>
                  <h3 class="mt-8 text-2xl font-bold tracking-tight text-ink">
                    {layer.heading}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">
                    {layer.body}
                  </p>
                  <ul class="mt-auto flex list-none flex-wrap gap-1.5 pt-7" role="list">
                    {layer.chips.map((chip) => (
                      <li class="rounded border border-hairline/70 bg-white/70 px-2 py-1 font-mono text-[8px] tracking-wider text-muted-soft">
                        {chip}
                      </li>
                    ))}
                  </ul>
                </div>
              </article>

              {index < layers.length - 1 && (
                <div class="relative hidden items-center justify-center bg-white md:flex" aria-hidden="true">
                  <span class="absolute h-px w-full bg-hairline"></span>
                  <span class="relative grid h-6 w-6 place-items-center rounded-full border border-success/30 bg-white font-mono text-xs text-ink">
                    →
                  </span>
                </div>
              )}
            </>
          ))
        }
      </div>

      <div class="grid border-t border-hairline bg-surface-soft/40 md:grid-cols-[1.25fr_0.75fr]">
        <div class="p-6 sm:p-8">
          <span class="font-mono text-[9px] font-bold uppercase tracking-[0.2em] text-ink">
            {punchline.label}
          </span>
          <h3 class="mt-2 text-xl font-bold tracking-tight text-ink sm:text-2xl">
            {punchline.heading}
          </h3>
          <p class="mt-2 max-w-[620px] text-sm leading-relaxed text-muted">
            {punchline.body}
          </p>
        </div>

        <dl class="grid grid-cols-2 border-t border-hairline md:border-l md:border-t-0">
          <div class="flex flex-col justify-center p-5 sm:p-6">
            <dt class="font-mono text-[8px] uppercase tracking-[0.18em] text-muted-soft">
              Missing value
            </dt>
            <dd class="mt-2 flex items-center gap-2 font-mono text-xs font-bold text-ink">
              <span class="h-1.5 w-1.5 rounded-full bg-error"></span>
              UNAVAILABLE
            </dd>
          </div>
          <div class="flex flex-col justify-center border-l border-hairline p-5 sm:p-6">
            <dt class="font-mono text-[8px] uppercase tracking-[0.18em] text-muted-soft">
              Reasoning
            </dt>
            <dd class="mt-2 font-mono text-xs font-bold text-ink">
              TRACEABLE
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Container>
</section>
