---
/**
 * Security — what the terminal refuses to do.
 *
 * Renders `src/content/landing/refusals.ts`. Reframed from a vault claim to a
 * refusal list because FEATURE_CATALOGUE section 13.3 could not verify the
 * Argon2id / AES-256 / Tauri Stronghold implementation, while every claim in
 * the refusal list is code-verified and two of them are enforced by tests.
 *
 * Anchor id stays `#security` for existing inbound links.
 */
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { refusals as content } from '@/content/landing';

const { intro, pills, refusals } = content;

const pillIconClasses = {
  lavender: 'text-ink',
  violet: 'text-ink',
  orange: 'text-ink',
  pink: 'text-ink',
};
---

<section
  class="section-y bg-canvas"
  id={intro.id}
  aria-labelledby="security-heading"
>
  <Container>
    <div
      class="mx-auto grid max-w-[1080px] gap-9 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16"
    >
      <div
        class="flex flex-col items-start lg:pt-5"
        data-reveal-group
      >
        <div data-reveal-item>
          <Badge variant="lavender">{intro.badge}</Badge>
        </div>
        <h2
          id="security-heading"
          class="mt-4 type-display-md leading-[1.08] tracking-tight text-ink"
          data-reveal-item
        >
          {intro.heading}
        </h2>
        {
          intro.body && (
            <p
              class="mt-4 max-w-[390px] text-base leading-relaxed text-muted"
              data-reveal-item
            >
              {intro.body}
            </p>
          )
        }

        <div class="mt-7 flex flex-wrap gap-2" data-reveal-item>
          {
            pills.map((pill) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline/60 bg-white px-3 py-1.5 text-[10px] text-muted">
                <Icon
                  name={pill.icon}
                  size={12}
                  class={pillIconClasses[pill.accent]}
                />
                {pill.label}
              </span>
            ))
          }
        </div>
      </div>

      <div
        class="overflow-hidden rounded-[1.5rem] border border-hairline bg-white"
        data-reveal-group
      >
        <div class="flex items-center justify-between gap-4 border-b border-hairline bg-surface-strong px-5 py-3 text-ink sm:px-6">
          <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-ink">
            Hard boundaries
          </span>
          <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted">
            Enforced in code
          </span>
        </div>

        <dl role="list">
          {
            refusals.map((refusal, index) => (
              <div
                class="grid gap-3 border-b border-hairline/80 p-4 last:border-b-0 sm:grid-cols-[2rem_1fr_auto] sm:items-center sm:gap-4 sm:px-6 sm:py-5"
                data-reveal-item
              >
                <div
                  class="grid h-7 w-7 place-items-center rounded-full bg-error/10 font-mono text-[9px] font-bold text-ink"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </div>
                <div class="min-w-0">
                  <dt class="text-sm font-bold text-ink sm:text-base">
                    {refusal.title}
                  </dt>
                  <dd class="mt-1 text-xs leading-relaxed text-muted">
                    {refusal.body}
                  </dd>
                </div>
                <span class="w-fit rounded border border-success/20 bg-success/5 px-2 py-1 font-mono text-[8px] uppercase tracking-[0.12em] text-ink">
                  {refusal.proof}
                </span>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Container>
</section>
