---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'text-link' | 'glass';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  liquidGlass?: boolean;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
  id,
  type = 'button',
  liquidGlass: enableLiquidGlass = true,
  disabled = false,
} = Astro.props;
const Tag = href ? 'a' : 'button';

const baseClass =
  'action-button liquid-glass-btn relative inline-flex items-center justify-center gap-2 font-body font-semibold cursor-pointer no-underline transition-all duration-300 ease-out active:scale-[0.96] overflow-hidden group select-none border hover:scale-[1.02]';

const sizeClasses = {
  sm: 'px-4 py-2 text-[13px] h-[36px] rounded-full',
  md: 'px-6 py-2.5 text-sm h-[42px] rounded-full',
  lg: 'px-8 py-3.5 text-base h-[50px] rounded-full',
};

const isGlassVariant =
  variant === 'primary' || variant === 'secondary' || variant === 'glass';
---

<Tag
  href={href}
  id={id}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[
    baseClass,
    sizeClasses[size],
    className,
  ]}
  data-liquid-glass={enableLiquidGlass && isGlassVariant ? 'true' : undefined}
>
  <span class="relative z-10 flex items-center justify-center gap-2">
    <slot />
  </span>
</Tag>

<script>
  import { liquidGlass } from '@/utils/liquid-glass';

  const instances = new Map<HTMLElement, ReturnType<typeof liquidGlass>>();

  function initButtonLiquidGlass() {
    const buttons = document.querySelectorAll<HTMLElement>(
      '[data-liquid-glass="true"]'
    );

    buttons.forEach((btn) => {
      if (instances.has(btn)) {
        instances.get(btn)?.refresh();
        return;
      }

      const instance = liquidGlass(btn, {
        scale: -70,
        chroma: 5,
        border: 0.05,
        mapBlur: 8,
        blur: 4,
        saturate: 1.5,
        fallbackBlur: 14,
      });

      instances.set(btn, instance);
    });
  }

  // Initialize on load & Astro swap
  initButtonLiquidGlass();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initButtonLiquidGlass);
  }

  document.addEventListener('astro:after-swap', () => {
    instances.forEach((inst) => inst.destroy());
    instances.clear();
    initButtonLiquidGlass();
  });

</script>
