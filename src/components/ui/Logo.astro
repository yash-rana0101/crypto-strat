---
interface Props {
  class?: string;
  asSpan?: boolean;
}
const { class: className, asSpan = false } = Astro.props;
---

{
  asSpan ? (
    <span class:list={['inline-flex items-center gap-2', className]}>
      <img
        src="/strat.svg"
        alt="Strat Ai"
        class="h-[22px] md:h-[24px] w-auto object-contain shrink-0"
      />
      <span class="text-sm font-semibold text-ink tracking-tight">
        Strat Ai
      </span>
    </span>
  ) : (
    <a
      href="/"
      class:list={['inline-flex items-center gap-2 no-underline', className]}
      aria-label="Strat Ai — AI Trading Intelligence"
    >
      <img
        src="/strat.svg"
        alt="Strat Ai"
        class="h-[22px] md:h-[24px] w-auto object-contain shrink-0"
      />
      <span class="text-sm font-semibold tracking-tight text-ink">
        Strat Ai
      </span>
    </a>
  )
}
