---
/**
 * Careers — Open positions and culture page.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

const openings = [
  {
    title: 'Quantitative Researcher',
    team: 'Research',
    type: 'Full-time',
    location: 'Remote',
    desc: 'Research historical crypto spot and perpetual-futures data, develop quantitative models, and design indicators for the Trading and Research Wing.',
  },
  {
    title: 'UI/UX Engineer',
    team: 'Product',
    type: 'Full-time',
    location: 'Remote',
    desc: 'Design and build intuitive, data-dense interfaces for displaying order books, derivatives positioning, metrics, and terminal layouts.',
  },
  {
    title: 'Trading Operations Analyst',
    team: 'Operations',
    type: 'Full-time',
    location: 'Remote',
    desc: 'Monitor crypto market risk parameters, analyze market data, and improve analysis metrics within the terminal.',
  },
];

const perks = [
  {
    icon: 'zap',
    title: 'Remote-First',
    desc: 'Work from anywhere with async-first collaboration.',
  },
  {
    icon: 'chart',
    title: 'Team Ownership',
    desc: 'Early team members can share in the company’s long-term growth.',
  },
  {
    icon: 'brain',
    title: 'Research Focus',
    desc: 'Collaborative time dedicated to exploring new market models and quantitative theories.',
  },
  {
    icon: 'layers',
    title: 'Learning Budget',
    desc: 'Annual learning budget for training, certifications, and resources.',
  },
];
---

<PageLayout
  title="Careers & Quantitative Research Roles"
  description="Join the Trading & Research Wing (TRW) to research crypto spot and perpetual-futures markets, develop quantitative models, and build analysis tools."
  badge="We're Hiring"
  badgeVariant="lavender"
  breadcrumbs={[{ label: 'Careers', href: '/careers' }]}
>
  <!-- Culture -->
  <section class="py-16 md:py-20 bg-canvas transition-colors duration-300">
    <Container size="wide" class="!px-0">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 border-y border-hairline divide-y lg:divide-y-0 lg:divide-x divide-hairline bg-surface-soft/5"
      >
        <div class="flex flex-col gap-5 p-8 md:p-12 lg:p-14">
          <Badge variant="violet">Our Culture</Badge>
          <h2 class="type-display-sm tracking-tight text-ink">
            Small team, outsized impact
          </h2>
          <p class="type-body-md text-muted leading-relaxed">
            We're a lean, research-driven team of quants, engineers, and market
            specialists dedicated to providing robust quantitative analysis tools
            for crypto markets. Every person here participates in
            active research, develops insights, and moves the needle.
          </p>
        </div>
        <div class="grid grid-cols-2 divide-x divide-y divide-hairline">
          {
            perks.map((perk) => (
              <div class="flex flex-col gap-2 p-6 md:p-8 hover:bg-surface-soft/10 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-badge-lavender/10 flex items-center justify-center">
                  <Icon name={perk.icon} class="w-4 h-4 text-ink" />
                </div>
                <h4 class="type-title-sm text-ink">{perk.title}</h4>
                <p class="type-body-sm text-muted-soft">{perk.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Open Roles -->
  <section class="py-16 md:py-20 bg-canvas transition-colors duration-300">
    <Container>
      <div class="max-w-[800px] mx-auto text-center mb-12">
        <Badge variant="lavender" class="mb-4">Open Positions</Badge>
        <h2 class="type-display-lg leading-[1.1] tracking-tight text-ink">
          Current openings
        </h2>
        <p class="type-body-md text-muted mt-4">
          We're looking for exceptional people who want to build at the
          intersection of AI and crypto market research.
        </p>
      </div>
    </Container>
    <Container size="wide" class="!px-0">
      <div
        class="border-y border-hairline divide-y divide-hairline bg-surface-soft/5"
      >
        {
          openings.map((role) => (
            <div class="p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-8 hover:bg-surface-soft/10 transition-colors group">
              <div class="flex-1">
                <h3 class="type-title-md text-ink group-hover:text-ink transition-colors">
                  {role.title}
                </h3>
                <p class="type-body-sm text-muted mt-1">{role.desc}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2 shrink-0">
                <span class="px-2.5 py-1 text-[11px] font-medium bg-surface-card border border-hairline/60 rounded-full text-muted">
                  {role.team}
                </span>
                <span class="px-2.5 py-1 text-[11px] font-medium bg-surface-card border border-hairline/60 rounded-full text-muted">
                  {role.type}
                </span>
                <span class="px-2.5 py-1 text-[11px] font-medium bg-surface-card border border-hairline/60 rounded-full text-muted">
                  {role.location}
                </span>
              </div>
              <Button
                variant="secondary"
                size="sm"
                href={`mailto:careers@stratai.live?subject=Application: ${role.title}`}
                class="!rounded-full shrink-0"
              >
                Apply
              </Button>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-canvas transition-colors duration-300">
    <Container size="wide" class="!px-0">
      <div
        class="border-y border-hairline bg-surface-soft/5 p-8 md:p-12 lg:p-16 text-center"
      >
        <h2 class="type-display-md tracking-tight text-ink mb-4">
          Don't see your role?
        </h2>
        <p class="type-body-md text-muted max-w-[500px] mx-auto mb-8">
          We're always looking for exceptional talent. Send us your resume and
          tell us how you'd contribute.
        </p>
        <Button
          variant="primary"
          size="lg"
          href="mailto:careers@stratai.live"
          class="!rounded-full px-8">Send Resume</Button
        >
      </div>
    </Container>
  </section>
</PageLayout>
