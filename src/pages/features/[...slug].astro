---
/**
 * Canonical crypto feature pages. Legacy backend feature copy is not published.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { PRODUCT_AREAS } from '@/constants/agent';

export async function getStaticPaths() {
  return PRODUCT_AREAS.map((area) => ({
    params: { slug: area.path.split('/').pop() },
    props: { area },
  }));
}

const area = Astro.props.area;

if (!area) {
  return Astro.redirect('/404');
}

const data = {
  title: area.title,
  description: area.summary,
};

const featureSchema = {
  '@type': 'WebApplication',
  name: data.title,
  description: data.description,
  applicationCategory: 'FinancialApplication, BusinessApplication',
  operatingSystem: 'Windows, macOS, Linux, Web',
};
---

<PageLayout
  title={data.title}
  description={data.description}
  badge="Crypto Analysis"
  badgeVariant="lavender"
  breadcrumbs={[
    { label: 'Features', href: '/#features' },
    { label: data.title, href: area.path },
  ]}
  jsonLd={featureSchema}
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-canvas transition-colors duration-300">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="flex flex-col gap-6" data-reveal-group>
          <Badge variant="lavender" class="w-fit"
            >Crypto Spot & Perpetual Futures</Badge
          >
          <h1
            class="type-display-md text-ink leading-tight font-display font-extrabold"
          >
            {data.title}
          </h1>
          <p class="type-body-md text-muted leading-relaxed">
            {data.description}
          </p>

          <p class="type-body-sm text-muted">
            Strat AI provides crypto market analysis and pre-trade risk research.
            It does not place orders or provide financial advice.
          </p>

          <div class="mt-4 flex gap-4">
            <Button
              variant="primary"
              href="/waitlist"
              class="!rounded-full px-6 py-2 text-xs font-semibold"
              >Join Waitlist</Button
            >
            <Button
              variant="secondary"
              href="/pricing"
              class="!rounded-full px-6 py-2 text-xs font-semibold"
              >Explore Plans</Button
            >
          </div>
        </div>

        <!-- Crypto research overview -->
        <div
          class="relative rounded-2xl overflow-hidden border border-hairline/80 shadow-[0_20px_50px_rgba(124,58,237,0.06)] bg-surface-card p-4 aspect-video flex items-center justify-center"
        >
          <div
            class="absolute inset-0 opacity-[0.03] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,black_20%,transparent_80%)]"
            style="background-image: linear-gradient(var(--color-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px); background-size: 32px 32px;"
          >
          </div>
          <div class="z-10 text-center">
            <div
              class="w-12 h-12 rounded-xl bg-badge-lavender/10 border border-badge-lavender/20 text-ink flex items-center justify-center mx-auto mb-4"
            >
              <Icon name="zap" size={24} />
            </div>
            <span class="type-title-sm text-ink block font-bold"
              >Crypto Market Research</span
            >
            <span class="type-body-sm text-muted mt-1 block"
              >Spot pairs and perpetual futures analysis</span
            >
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Technical Specs & Pipeline Section -->
  <section
    class="py-16 bg-surface-soft/10 border-t border-hairline transition-colors duration-300"
  >
    <Container>
      <div class="max-w-[700px] mx-auto text-center mb-16">
        <Badge variant="lavender" class="mb-4"
          >Analysis & Risk</Badge
        >
        <h2 class="type-display-sm text-ink font-bold">Explore Strat AI</h2>
      </div>

      <div class="max-w-[800px] mx-auto bg-surface-card border border-hairline rounded-2xl p-8 md:p-12 text-center">
        <p class="type-body-md text-muted leading-relaxed">
          Explore the crypto analysis workflow and pre-trade risk rules on our homepage.
          Join the waitlist for private beta access.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <Button variant="secondary" href="/#features">Explore Analysis</Button>
          <Button variant="primary" href="/waitlist">Join Waitlist</Button>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
